<?xml version="1.0" encoding="UTF-8"?>
<!-- File: src/main/mule/salesfore-accounts-api.xml -->
<mule xmlns:salesforce="http://www.mulesoft.org/schema/mule/salesforce" xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
http://www.mulesoft.org/schema/mule/salesforce http://www.mulesoft.org/schema/mule/salesforce/current/mule-salesforce.xsd">

<!-- ============ POST /api/accounts : create ============ -->                      
	<flow name="create-account-flow" doc:id="25295d41-1a1d-4486-ae9b-8a54204404ae" >
		<http:listener doc:name="POST /accounts" doc:id="a4fcf680-d82a-4ac5-8bf7-6766e71edc5c" config-ref="HTTP_Listener_config" path="/accounts" allowedMethods="POST">
			<http:response statusCode="#[vars.httpStatus default 200]" />
			<http:error-response statusCode="#[vars.httpStatus default 500]" >
				<http:body ><![CDATA[#[payload]]]></http:body>
			</http:error-response>
		</http:listener>
		<set-variable value="#[payload]" doc:name="Save Request" doc:id="e3e37a3b-906d-49bc-ab31-61d3d490f641" variableName="requestBody"/>
		<choice doc:name="Valid?" doc:id="a4d2dc5f-fbd6-4dcc-9c97-0019e2df2b1a" >
			<when expression="#[isEmpty(payload.companyName)]">
				<raise-error doc:name="Invalid" doc:id="75556c80-9bf9-4252-8408-1fd6a70c1de2" type="ACCOUNT:INVALID_REQUEST" description="companyName is required"/>
			</when>
		</choice>
		<ee:transform doc:name="Request to Account" doc:id="bc266eb8-8308-4b44-ad37-330d66d8d3b7" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/java
---
[{
	Name: payload.companyName,
	Phone: payload.phone,
	Website: payload.website,
	BillingCity: payload.city,
	Industry: payload.industry,
	Customer_Id__c: payload.customerId
} filterObject ((value) -> value != null)]]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<salesforce:create type="Account" doc:name="Create Account" doc:id="536852c6-e853-4781-b704-f6631d7d8b33" config-ref="Salesforce_Config"/>
		<choice doc:name="Created?" doc:id="005bf3f4-b96b-4bf9-97f4-72c243f2c472" >
			<when expression="#[not payload.successful]">
				<raise-error doc:name="Create failed" doc:id="d11d2819-3cc1-4003-b159-eb2ee1eadfa2" type="ACCOUNT:CREATE_FAILED" description="#[payload.item[0].message default 'Salesforce rejected the Account']"/>
			</when>
		</choice>
		<set-variable value="#[201]" doc:name="Status 201" doc:id="a82455a9-3dd8-4877-99f3-218e6f4c78ad" variableName="httpStatus"/>
		<ee:transform doc:name="Build Response" doc:id="65b089ca-7c44-4b45-8355-297a4aecef16" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	accountId: payload.items[0].id,
	name: vars.requestBody.companyName,
	status: "CREATED"
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<error-handler ref="accounts-error-handler" />
	</flow>

<!-- ============ GET /api/accounts?name= : query ============ -->
	<flow name="find-accounts-flow" doc:id="d61c9b02-9df3-4d8b-b864-d29f2e4977d1" >
		<http:listener doc:name="GET /accounts" doc:id="cd9de5f1-cb0d-433b-bcd1-f8fd31181ce4" config-ref="HTTP_Listener_config" path="/accounts" allowedMethods="GET">
			<http:response statusCode="#[vars.httpStatus default 200]" />
			<http:error-response statusCode="#[vars.httpStatus default 500]" >
				<http:body ><![CDATA[#[payload]]]></http:body>
			</http:error-response>
		</http:listener>
		<choice doc:name="Name given?" doc:id="ae4c3a4d-badc-4462-8487-e75c540eb9e3" >
			<when expression="#[isEmpty(attributes.queryParams.name)]">
				<raise-error doc:name="Invalid" doc:id="9f75f850-5930-4977-a914-4d94cd252ebc" type="ACCOUNT:INVALID_REQUEST" description="Query parameter 'name' is required"/>
			</when>
		</choice>
		<salesforce:query doc:name="Find Accounts by Name" doc:id="cd45ed24-c631-47d3-91ab-6e0ed2b0b1fa" config-ref="Salesforce_Config">
			<salesforce:salesforce-query ><![CDATA[SELECT Id, Name, Phone, BillingCity, Industry
FROM Account
WHERE Name = ':name']]></salesforce:salesforce-query>
			<salesforce:parameters ><![CDATA[#[{
	name: attributes.queryParams.name
}]]]></salesforce:parameters>
		</salesforce:query>
		<ee:transform doc:name="Records to JSON" doc:id="0d65b97f-e404-4812-a384-47a4bce34c2b" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---

	payload map ((account) -> {
		accountId: account.Id,
		name: account.Name,
		phone: account.Phone,
		city: account.BillingCity,
		industry: account.Industry
	})
]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<error-handler ref="accounts-error-handler" />
	</flow>

<!-- =========== PATCH /api/accounts/{accountId} ============ -->	
	<flow name="update-account-flow" doc:id="aa2b0fce-9103-4edb-8457-4d1ce8c6986b" >
		<http:listener doc:name="PATCH /accounts/{accountId}" doc:id="3b4fee32-f186-4647-94b9-fe4d38149506" config-ref="HTTP_Listener_config" path="/accounts/{accountId}" allowedMethods="PATCH">
			<http:response statusCode="#[vars.httpStatus default 200]" />
			<http:error-response statusCode="#[vars.httpStatus default 500]" >
				<http:body ><![CDATA[#[payload]]]></http:body>
			</http:error-response>
		</http:listener>
		<set-variable value="#[attributes.uriParams.accountId]" doc:name="Save Account ID" doc:id="c3d15a88-cf12-400d-8e32-e0a11b4c4eab" variableName="accountId"/>
		<ee:transform doc:name="Request to Account Update" doc:id="14cbdbc5-fa8e-4bb6-8c0e-930faa1d6172" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/java
---
[{
	Id: vars.accountId,
	Phone: payload.phone,
	BillingCity: payload.city
} filterObject ((value) -> value != null)]]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<salesforce:update type="Account" doc:name="Update Account" doc:id="7b95cac4-574c-4ee3-9df0-c727ea1dd96e" config-ref="Salesforce_Config"/>
		<choice doc:name="Updated?" doc:id="f1e4442e-bd13-4ed1-b1b0-5a4fb40a8cdd" >
			<when expression="#[not payload.successful]">
				<raise-error doc:name="Update Failed" doc:id="bf3b807e-1207-4f84-973f-fa72d2b706e7" type="ACCOUNT:UPDATE_FAILED" description="#[payload.items[0].message default 'Salesforce rejected the update']"/>
			</when>
		</choice>
		<ee:transform doc:name="Build Response" doc:id="f16a07da-7d16-4b05-ad43-02fa5a9e3e1b" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	accountId: vars.accountId,
	status: "UPDATED"
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<error-handler ref="accounts-error-handler" />
	</flow>
	
<!-- ============ PUT /api/accounts/by-customer/{customerId} : upsert ============ -->
	<flow name="upsert-account-flow" doc:id="c46a5c35-122b-4906-b0d2-85688721c6ef" >
		<http:listener doc:name="PUT /accounts/by-customer/{customerId}" doc:id="40d508ae-b715-40bd-86a2-26c13de858f5" config-ref="HTTP_Listener_config" path="/accounts/by-customer/{customerId}">
			<http:response statusCode="#[vars.httpStatus default 200]" />
			<http:error-response statusCode="#[vars.httpStatus default 500]" >
				<http:body ><![CDATA[#[payload]]]></http:body>
			</http:error-response>
		</http:listener>
		<set-variable value="#[attributes.uriParams.customerId]" doc:name="Save Customer ID" doc:id="8d0fa06e-ecf7-43d1-875c-da0845f966a2" variableName="customerId"/>
		<choice doc:name="Valid?" doc:id="5290039a-38c5-45f5-b9eb-821b630ecd85" >
			<when expression="#[isEmpty(payload.companyName)]">
				<raise-error doc:name="Invalid" doc:id="205e7cc1-cd03-458b-af30-501b1245b5c5" type="ACCOUNT:INVALID_REQUEST" description="companyName is required"/>
			</when>
		</choice>
		<ee:transform doc:name="Request to Account" doc:id="c123fa3b-3916-44f9-9892-e17d72d91515" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/java
---
[{
	Customer_Id__c: vars.customerId,
	Name: payload.companyName,
	Phone: payload.phone,
	BillingCity: payload.city
} filterObject ((value) -> value != null)]]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<salesforce:upsert objectType="Account" externalIdFieldName="Customer_Id__c" doc:name="Upsert Account" doc:id="d6c28497-d9cd-4d05-888f-38a0ee6d6b0a" config-ref="Salesforce_Config"/>
		<choice doc:name="Saved?" doc:id="33806f35-b269-44ff-bf77-a8de4daaab3e" >
			<when expression="#[not payload.successful]">
				<raise-error doc:name="Upsert Failed" doc:id="feed618c-2bda-4ea0-88ff-b5533cefab34" type="ACCOUNT:UPSERT_FAILED" description="#[payload.items[0].message default 'Salesforce rejected the Account']"/>
			</when>
		</choice>
		<ee:transform doc:name="Build Response" doc:id="4e06020f-d655-400b-b199-b610d08503ed" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	accountId: payload.items[0].id,
	customerId: vars.customerId,
	status: "SAVED"
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</flow>
	<sub-flow name="build-error-response-subflow" doc:id="53cff18b-10ba-48de-a453-fc54ee524103" >
		<ee:transform doc:name="Error JSON" doc:id="e77753e2-b8c9-40a4-832d-501c193383a5" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	status: "ERROR",
	errorCode: vars.errorCode,
	message: vars.errorMessage,
	correlationId: correlationId
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</sub-flow>
	
<!-- ============ Error handling ============ -->
	<error-handler name="accounts-error-handler" doc:id="52fc4d1e-d2d8-4eb7-9f46-6ec914782f0b" >
		<on-error-propagate enableNotifications="true" logException="false" doc:name="ACCOUNT:INVALID_REQUEST" doc:id="76e00ebf-4360-4c0b-aedf-79721bfcfb8c" type="ACCOUNT:INVALID_REQUEST">
			<set-variable value="#[400]" doc:name="httpStatus 400" doc:id="ed015f41-b313-4424-8b1e-038eb82d3bb5" variableName="httpStatus"/>
			<set-variable value="INVALID_REQUEST" doc:name="erroCode" doc:id="016a318d-9dda-49e2-97ad-371081866614" variableName="errorCode"/>
			<set-variable value="#[error.description]" doc:name="errorMessage" doc:id="706e8d1f-0f22-4126-9357-472b91828210" variableName="errorMessage"/>
			<flow-ref doc:name="Build Error Response Subflow" doc:id="5e9d7c70-9022-4d2f-b4e0-3df229957440" name="build-error-response-subflow"/>
		</on-error-propagate>
		<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="37a47451-2754-4ff0-9317-111e9a8a3e00" type="ACCOUNT:CREATE_FAILED, ACCOUNT:UPDATE_FAILED, ACCOUNT:UPSERT_FAILED">
			<set-variable value="#[422]" doc:name="httpStatus 422" doc:id="e43be541-d9bb-4b39-b191-88d027f18010" variableName="httpStatus" />
			<set-variable value="SALESFORCE_REJECTED" doc:name="errorCode" doc:id="03f6048e-7eef-4fef-a72a-466f910ad384" variableName="errorCode" />
			<set-variable value="#[error.description]" doc:name="errorMessage" doc:id="14c21c8f-46aa-4168-9313-99dd17ecec41" variableName="errorMessage" />
			<flow-ref doc:name="Build Error Response Subflow" doc:id="3085b3cd-3db6-4fd9-b64c-0c296714c14a" name="build-error-response-subflow" />
		</on-error-propagate>
		<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="0fb55bb3-2410-462d-b090-0cecbe87516e" type="SALESFORCE:CONNECTIVITY">
			<set-variable value="#[503]" doc:name="httpStatus 503" doc:id="df53c58f-dc83-4ad0-9ecb-749a75c7bf70" variableName="httpStatus" />
			<set-variable value="SALESFORCE_UNAVAILABLE" doc:name="errorCode" doc:id="0e4fee66-de43-4364-8d16-e1d56343ede9" variableName="errorCode" />
			<set-variable value='"Salesforce is temporarily unavailable"' doc:name="errorMessage" doc:id="1cc0dbf5-8d8b-4a01-a9f0-25582d1ff062" variableName="errorMessage" />
			<flow-ref doc:name="Build Error Response Subflow" doc:id="5210d7f7-8cc0-4a92-be7f-8083d85033bc" name="build-error-response-subflow" />
		</on-error-propagate>
		<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="dc99ab72-e5c6-48e2-9e51-f2d13d3fa49d" when="#[error.errorType.namespace == 'SALESFORCE']">
			<set-variable value="#[502]" doc:name="httpStatus 502" doc:id="6373ce2e-847c-4ab8-b4a4-908e4525821f" variableName="httpStatus" />
			<set-variable value="SALESFORCE_ERROR" doc:name="errorCode" doc:id="bcf43c75-11b9-4c86-86dd-95227a40af44" variableName="errorCode" />
			<set-variable value='"Salesforce returned an error"' doc:name="errorMessage" doc:id="d34c3f6a-b3d6-4d11-b467-855e2de6ff5a" variableName="errorMessage" />
			<flow-ref doc:name="Build Error Response Subflow" doc:id="f5f8fe24-b1c7-4390-8e76-83e58e41954f" name="build-error-response-subflow" />
		</on-error-propagate>
		<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="5776df8a-973d-45de-9b3b-bd996a8437da" type="ANY">
			<set-variable value="#[500]" doc:name="httpStatus 500" doc:id="0f35d6e0-425f-4a50-b813-b703667840a6" variableName="httpStatus" />
			<set-variable value="INTERNAL_ERROR" doc:name="errorCode" doc:id="b0bf7d01-1c3c-4ce7-95c8-2c9ad5481149" variableName="errorCode" />
			<set-variable value='"An unexpected error occurred"' doc:name="errorMessage" doc:id="42638b3e-6e43-4481-b880-4ce7ed011cfb" variableName="errorMessage" />
			<flow-ref doc:name="Build Error Response Subflow" doc:id="b1e7a001-181b-4a1e-9468-181a4a350b00" name="build-error-response-subflow" />
		</on-error-propagate>
	</error-handler>
</mule>
